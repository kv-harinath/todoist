POSTGRES_USER=todoist
POSTGRES_PASSWORD=todoist
POSTGRES_DB=todoist
JWT_SECRET_KEY=change-me-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_EMAIL_VERIFICATION=false

# Reminder delivery (optional). Email: set SMTP_HOST. Push: run
# `python backend/scripts/generate_vapid_keys.py` and paste the pair.
REMINDER_WORKER_ENABLED=true
REMINDER_POLL_SECONDS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Todoist Clone <no-reply@example.com>
SMTP_STARTTLS=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
