# Used only when running the backend directly (no Docker) - see README Option B.
# Adjust user/password/db name/host/port to match your local Postgres.
DATABASE_URL=postgresql+asyncpg://todoist:todoist@localhost:5432/todoist
JWT_SECRET_KEY=change-me-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_EMAIL_VERIFICATION=false
REMINDER_WORKER_ENABLED=true
SMTP_HOST=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
